#!/bin/bash

# The child shortcut layer stays active in both modes. Standard app keys
# route through the current approved list; work, social and AI keys stay off.
# Free Time keeps Super+Return available for parent maintenance, as in the
# original child profile. `exit` restores the user's actual configuration.

set -Eeuo pipefail

PLUGIN_ID=io.github.peterholko.school-mode
HYPRCTL_BIN=${OMARCHY_SCHOOL_HYPRCTL:-hyprctl}
RUNTIME_ROOT=${XDG_RUNTIME_DIR:?Run this command in the Omarchy desktop session}
STATE_DIR=$RUNTIME_ROOT/omarchy-community-school-mode
ACTIVE_MARKER=$STATE_DIR/shortcut-policy.active
LOCK_FILE=$STATE_DIR/shortcut-policy.lock

usage() {
  echo "Usage: shortcut-policy enter [school|free] | exit | status" >&2
  exit 2
}

json_result() {
  local action=$1 applied=$2 changed=$3 error=${4:-}
  jq -nc --arg action "$action" --argjson applied "$applied" --argjson changed "$changed" --arg error "$error" \
    '{version: 1, action: $action, applied: $applied, changed: $changed} + (if $error == "" then {} else {error: $error} end)'
}

reload_bindings() {
  local output
  if ! output=$($HYPRCTL_BIN reload 2>&1); then
    printf '%s' "$output"
    return 1
  fi
}

umask 077
[[ ! -L $STATE_DIR ]] || { echo "Refusing a symlink state directory" >&2; exit 1; }
mkdir -p -- "$STATE_DIR"
[[ -O $STATE_DIR ]] || { echo "State directory has another owner" >&2; exit 1; }
chmod 700 "$STATE_DIR"
[[ ! -L $LOCK_FILE ]] || { echo "Refusing a symlink lock" >&2; exit 1; }
chmod 700 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9

case ${1:-} in
  status)
    if [[ -f $ACTIVE_MARKER ]]; then json_result status true 0; else json_result status false 0; fi
    exit 0
    ;;
  exit)
    if [[ ! -f $ACTIVE_MARKER ]]; then json_result exit false 0; exit 0; fi
    if error=$(reload_bindings); then
      rm -f -- "$ACTIVE_MARKER"
      json_result exit false 0
      exit 0
    fi
    json_result exit true 0 "Could not restore Hyprland bindings: $error"
    exit 1
    ;;
  enter)
    MODE=${2:-school}
    [[ $MODE == "school" || $MODE == "free" ]] || usage
    ;;
  *) usage ;;
esac

# A shell reload can build this layer again without leaving it first: start
# from the real configuration so nothing accumulates.
if [[ -f $ACTIVE_MARKER ]]; then
  if ! error=$(reload_bindings); then
    json_result enter false 0 "Could not reset the previous shortcut layer: $error"
    exit 1
  fi
  rm -f -- "$ACTIVE_MARKER"
fi

lua_program=""
changed=0
append_lua() { printf -v lua_program '%s%s\n' "$lua_program" "$1"; changed=$((changed + 1)); }
unbind() { append_lua "hl.unbind(\"$1\")"; }
rebind() { append_lua "hl.unbind(\"$1\")"; append_lua "hl.bind(\"$1\", hl.dsp.exec_cmd([[$2]]), { description = \"$3\" })"; }
launch_allowed() {
  rebind "$1" "omarchy-shell shell call $PLUGIN_ID launchAllowedApp '{\"desktopId\":\"$2\",\"name\":\"$3\",\"variant\":\"${4:-}\"}'" "Approved apps: $3"
}

# The menu shortcuts open the filtered menu while the stock one is off.
rebind "SUPER + SPACE" "omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"root\"}'" "School / Free Time: Menu"
rebind "SUPER + ALT + SPACE" "omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"apps\"}'" "School / Free Time: Apps"

# The stock capture shortcuts also open omarchy.menu, which is disabled in
# both child modes. Use our curated capture subtree and preserve stop-first
# recording behavior without restoring the unrestricted launcher.
rebind "SUPER + CTRL + C" "omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"trigger.capture\"}'" "School / Free Time: Capture"
rebind "ALT + PRINT" "omarchy-capture-screenrecording --stop-recording || omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"trigger.capture.screenrecord\"}'" "School / Free Time: Screenrecording"

# School retains its no-terminal shortcut policy. Free Time restores the
# original parent maintenance shortcut when the previous layer is reloaded.
if [[ $MODE == "school" ]]; then unbind "SUPER + RETURN"; fi
unbind "SUPER + SHIFT + RETURN"
unbind "SUPER + SHIFT + F"
unbind "SUPER + ALT + SHIFT + F"
unbind "SUPER + SHIFT + B"
unbind "SUPER + SHIFT + ALT + B"
unbind "SUPER + SHIFT + N"
unbind "SUPER + ALT + RETURN"
unbind "SUPER + CTRL + RETURN"
unbind "SUPER + SHIFT + M"
unbind "SUPER + SHIFT + D"
unbind "SUPER + SHIFT + G"
unbind "SUPER + SHIFT + O"
unbind "SUPER + SHIFT + W"
unbind "SUPER + SHIFT + A"
unbind "SUPER + SHIFT + C"
unbind "SUPER + SHIFT + E"
unbind "SUPER + SHIFT + S"
unbind "SUPER + SHIFT + Y"
unbind "SUPER + SHIFT + P"
unbind "SUPER + SHIFT + X"
unbind "SUPER + SHIFT + ALT + M"
unbind "SUPER + SHIFT + ALT + A"
unbind "SUPER + SHIFT + ALT + E"
unbind "SUPER + SHIFT + ALT + G"
unbind "SUPER + SHIFT + ALT + X"
unbind "SUPER + SHIFT + CTRL + G"
unbind "SUPER + SHIFT + SLASH"
unbind "SUPER + SHIFT + K"
unbind "SUPER + SHIFT + ALT + K"

if [[ $MODE == "free" ]]; then
  launch_allowed "SUPER + SHIFT + RETURN" "chromium" "Chromium"
  launch_allowed "SUPER + SHIFT + B" "chromium" "Chromium"
  launch_allowed "SUPER + SHIFT + ALT + B" "chromium" "Chromium (private)" "private"
  launch_allowed "SUPER + SHIFT + F" "org.gnome.Nautilus" "Files"
  launch_allowed "SUPER + ALT + SHIFT + F" "org.gnome.Nautilus" "Files (current directory)" "cwd"
  launch_allowed "SUPER + SHIFT + N" "omawrite" "Omawrite"
  launch_allowed "SUPER + SHIFT + W" "omawrite" "Omawrite"
  launch_allowed "SUPER + SHIFT + O" "obsidian" "Obsidian"
  launch_allowed "SUPER + SHIFT + M" "cliamp" "Cliamp"
  launch_allowed "SUPER + SHIFT + ALT + M" "cliamp" "Cliamp"
  launch_allowed "SUPER + SHIFT + S" "Google Maps" "Google Maps"
  launch_allowed "SUPER + SHIFT + K" "Khan Academy" "Khan Academy"
  launch_allowed "SUPER + SHIFT + ALT + K" "Wikipedia" "Wikipedia"
fi

printf 'version=3\nmode=%s\n' "$MODE" >"$ACTIVE_MARKER"
if ! error=$($HYPRCTL_BIN eval "$lua_program" 2>&1); then
  reload_bindings >/dev/null 2>&1 || true
  rm -f -- "$ACTIVE_MARKER"
  json_result enter false "$changed" "Could not apply the approved-app shortcuts: $error"
  exit 1
fi
json_result enter true "$changed"
