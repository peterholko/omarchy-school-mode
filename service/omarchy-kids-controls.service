[Unit]
Description=Omarchy community controls and optional game verification
After=systemd-logind.service NetworkManager.service systemd-resolved.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/lib/omarchy-kids-controls/runtime.py daemon
Environment=OMARCHY_PATH=/usr/share/omarchy
Environment=PATH=/usr/share/omarchy/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3
RuntimeDirectory=omarchy-kids-controls
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/etc/omarchy-kids-controls /var/lib/omarchy-kids-controls /run/omarchy-kids-controls
ReadWritePaths=-/etc/chromium/policies/managed -/etc/opt/chrome/policies/managed
ReadWritePaths=-/etc/NetworkManager/conf.d -/etc/systemd/resolved.conf.d

[Install]
WantedBy=multi-user.target
